# Obrigatório: senha do painel /admin
ADMIN_PASSWORD=troque-esta-senha
# Recomendado: segredo para assinar a sessão (string longa aleatória)
SESSION_SECRET=
# Persistência (Upstash Redis via Vercel Marketplace preenche isto sozinho)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Opcional: Riot API (elo e importação de partidas). Chave em https://developer.riotgames.com
RIOT_API_KEY=
# RIOT_PLATFORM=br1
# RIOT_REGION=americas

# ── Etapas 1–5 ──
# Fuso das datas digitadas no painel (padrão -03:00 = Brasília). Usado nos lembretes "partida prestes a começar".
# TOURNAMENT_TZ_OFFSET=-03:00
# Notificações push (opcional). Gerar as chaves: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:contato@seudominio.com
# Lembretes automáticos: segredo exigido por /api/cron/lembretes (Authorization: Bearer <valor>)
# CRON_SECRET=
